BASE_URL=https://your-application.example
ENVIRONMENT=QA

# Main ERP user. DEFAULT_BRANCH is the office (branch) chosen after sign-in when the user has more than one.
# Leave it empty for a user with only one office: no Office Selection screen appears and nothing is chosen.
# Write any text that matches ONE office in the list, e.g. the office code or the end of its name:
#   DEFAULT_BRANCH=6981            ([BO - 6981] ... - Development)
#   DEFAULT_BRANCH=- Development
ERP_USERNAME=your_username
ERP_PASSWORD=your_password
DEFAULT_BRANCH=- Development

# Second user: the employee an asset is assigned to (Asset Assign Acknowledgement tests). Same rules.
ASSIGN_ERP_USERNAME=your_assigned_user_username
ASSIGN_ERP_PASSWORD=your_assigned_user_password
ASSIGN_DEFAULT_BRANCH=- Development
# Employee PIN of the second user. Optional: when empty it is worked out from a numeric ASSIGN_ERP_USERNAME (15370 -> 00015370).
# ASSIGN_ERP_PIN=00015370

# Shipment acknowledgement user: the user who acknowledges the challan on Asset Shipment-In Challan.
# Its DEFAULT_BRANCH is the RECEIVING BRANCH of the shipment, so nothing else needs to name the branch.
# The projects are not set here: the From Project is the project of the transferred asset, and the
# tests choose the To Project (the same project, or a different one) for each scenario.
# Leave all three empty when the main user (ERP_USERNAME) acknowledges in its own branch.
# Otherwise it must be a different user from ERP_USERNAME (the ERP allows one login per user)
# and it must have the Asset Shipment-In Challan menu.
ACK_SHIPMENT_ERP_USERNAME=your_assigned_user_username
ACK_SHIPMENT_ERP_PASSWORD=your_assigned_user_password
ACK_SHIPMENT_ERP_DEFAULT_BRANCH=

# FAHOV2-643 asset registration / addition flow: HOFIN creates, HOFA acknowledges, HOFIN approves.
# Three different logins, one browser context each. HOFIN and HOFA must be connected
# and run on the same business date.
HOFIN_URL=https://hofin42.erp.bracits.net/
HOFA_URL=https://env42.erp.bracits.net/
HOFIN_CREATOR_USERNAME=your_hofin_creator_username
HOFIN_CREATOR_PASSWORD=your_hofin_creator_password
# The HOFA acknowledger also checks the HOFIN assets in the HOFA Asset Serial Global List
# (tests/test_32_asset_serial_global_list_hofin_assets.py, fixture hofa_logged_in_page).
HOFA_ACK_USERNAME=your_hofa_acknowledger_username
HOFA_ACK_PASSWORD=your_hofa_acknowledger_password
HOFIN_APPROVER_USERNAME=your_hofin_approver_username
HOFIN_APPROVER_PASSWORD=your_hofin_approver_password

# Never commit the real .env file — see .gitignore
