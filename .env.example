ENVIRONMENT=QA
TEST_USERNAME=your_username
TEST_PASSWORD=your_password
# Second user: the employee an asset is assigned to (Asset Assign Acknowledgement tests).
ASSIGN_USER_USERNAME=your_assigned_user_username
ASSIGN_USER_PASSWORD=your_assigned_user_password
# FAHOV2-643 asset registration / addition flow: HOFIN creates, HOFA acknowledges, HOFIN approves.
# Three different logins, one browser context each. HOFIN and HOFA must be connected
# and run on the same business date.
HOFIN_URL=https://hofin42.erp.bracits.net/
HOFA_URL=https://env42.erp.bracits.net/
HOFIN_CREATOR_USERNAME=your_hofin_creator_username
HOFIN_CREATOR_PASSWORD=your_hofin_creator_password
HOFA_ACK_USERNAME=your_hofa_acknowledger_username
HOFA_ACK_PASSWORD=your_hofa_acknowledger_password
HOFIN_APPROVER_USERNAME=your_hofin_approver_username
HOFIN_APPROVER_PASSWORD=your_hofin_approver_password
# Never commit the real .env file — see .gitignore
