BASE_URL=https://your-application.example
ENVIRONMENT=QA
TEST_USERNAME=your_username
TEST_PASSWORD=your_password
# Second user: the employee an asset is assigned to (Asset Assign Acknowledgement tests).
# The names are spelled exactly as the code reads them.
ASSGN_USER_USERNAME=your_assigned_user_username
ASSIGN_USER_PASSWROD=your_assigned_user_password
# For multi-role E2E flows, add additional role credentials as needed, e.g.:
# HOFA_USERNAME=your_hofa_username
# HOFA_PASSWORD=your_hofa_password
# Never commit the real .env file — see .gitignore
